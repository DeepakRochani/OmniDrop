{
  "name": "omni-airdrop",
  "version": "1.0.0",
  "description": "Universal Cross-Platform AirDrop for Android, iOS, Windows, Mac, Linux, and Tablets",
  "main": "api/index.js",
  "bin": {
    "omnidrop": "bin/omnidrop.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop": "electron desktop.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios"
  },
  "keywords": [
    "airdrop",
    "file-transfer",
    "p2p",
    "android",
    "ios",
    "cross-platform",
    "local-network"
  ],
  "author": "Antigravity",
  "license": "MIT"
}

